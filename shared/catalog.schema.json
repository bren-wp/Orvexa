{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orvexa Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lastUpdated": {
      "type": "string"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "publisher",
          "category",
          "provider",
          "wingetId",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "const": "winget"
          },
          "wingetId": {
            "type": "string",
            "minLength": 3
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
