<Window
    x:Class="Orvexa.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Orvexa">
    <Grid>
        <NavigationView x:Name="Nav"
                        PaneTitle="Orvexa"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="760"
                        ExpandedModeThresholdWidth="1160"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home"/>
                <NavigationViewItem Content="Catalog" Tag="catalog" Icon="Find"/>
                <NavigationViewItem Content="Updates" Tag="updates" Icon="Sync"/>
                <NavigationViewItem Content="Installed" Tag="installed" Icon="Library"/>
                <NavigationViewItem Content="This PC" Tag="device" Icon="Remote"/>
                <NavigationViewItem Content="Activity" Tag="activity" Icon="Clock"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
                <NavigationViewItem Content="About" Tag="about" Icon="Help"/>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ShellContent" Padding="24" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideLayout"/>
                        <VisualState x:Name="NarrowLayout">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HomeActions.Orientation" Value="Vertical"/>
                                <Setter Target="CatalogActions.Orientation" Value="Vertical"/>
                                <Setter Target="UpdateActions.Orientation" Value="Vertical"/>
                                <Setter Target="InstalledActions.Orientation" Value="Vertical"/>
                                <Setter Target="SearchBox.MinWidth" Value="180"/>
                                <Setter Target="UpdateSearchBox.MinWidth" Value="180"/>
                                <Setter Target="InstalledSearchBox.MinWidth" Value="180"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="DesktopLayout">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900"/></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HomeActions.Orientation" Value="Horizontal"/>
                                <Setter Target="CatalogActions.Orientation" Value="Horizontal"/>
                                <Setter Target="UpdateActions.Orientation" Value="Horizontal"/>
                                <Setter Target="InstalledActions.Orientation" Value="Horizontal"/>
                                <Setter Target="SearchBox.MinWidth" Value="240"/>
                                <Setter Target="UpdateSearchBox.MinWidth" Value="220"/>
                                <Setter Target="InstalledSearchBox.MinWidth" Value="220"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="HomeView">
                    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="ORVEXA" FontWeight="SemiBold"/>
                        <TextBlock Text="Software control center" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock Text="Install, update and organize Windows software from one focused workspace." Opacity=".72" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DeviceText" TextWrapping="Wrap"/>
                        <StackPanel x:Name="HomeActions" Orientation="Horizontal" Spacing="8">
                            <Button Content="Open catalog" Click="OpenCatalog_Click"/>
                            <Button Content="Installed apps" Click="OpenInstalled_Click"/>
                            <Button Content="Check updates" Click="ScanUpdates_Click"/>
                            <Button Content="System health" Click="Health_Click"/>
                            <Button Content="Refresh device" Click="Device_Click"/>
                        </StackPanel>
                        <TextBlock Text="Recommended for this PC" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <ItemsControl x:Name="Recommendations">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CatalogId}" Opacity=".62" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Find" Tag="{Binding CatalogId}" Click="Recommendation_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="CatalogView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Catalog" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Find software quickly. Orvexa uses its local catalog index first and refreshes from Windows Package Manager when needed." Opacity=".72" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="CatalogActions" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,12">
                        <TextBox x:Name="SearchBox" MinWidth="240" MaxWidth="420" PlaceholderText="Search software" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Search software"/>
                        <Button Content="Search" Click="Search_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Refresh local catalog" Click="BuildIndex_Click"/>
                        <Button x:Name="InstallSelectedButton" Content="Install selected" Click="InstallSelected_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="FavoriteSelectedButton" Content="Add to favorites" Click="FavoriteSelected_Click" IsEnabled="False"/>
                        <ToggleButton x:Name="FavoritesOnlyToggle" Content="Favorites only" Click="FavoritesOnly_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListView x:Name="CatalogResults" SelectionMode="Multiple" SelectionChanged="CatalogResults_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" Opacity=".62" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Opacity=".66" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="CatalogEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="No software found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try another search or refresh the local catalog." Opacity=".68" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="UpdatesView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Updates" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Review available versions before applying changes." Opacity=".72"/>
                    </StackPanel>
                    <StackPanel x:Name="UpdateActions" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,12">
                        <TextBox x:Name="UpdateSearchBox" MinWidth="220" MaxWidth="340" PlaceholderText="Filter updates" TextChanged="UpdateSearchBox_TextChanged" AutomationProperties.Name="Filter updates"/>
                        <Button Content="Check updates" Click="ScanUpdates_Click"/>
                        <Button x:Name="UpdateSelectedButton" Content="Update selected" Click="UpdateSelected_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="UpdateAllButton" Content="Update all" Click="UpdateAll_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListView x:Name="UpdateResults" SelectionMode="Multiple" SelectionChanged="UpdateResults_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" Opacity=".62" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InstalledVersion}" Opacity=".65"/>
                                            <TextBlock Text="to" Opacity=".55"/>
                                            <TextBlock Text="{Binding AvailableVersion}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="UpdatesEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="You're up to date" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="No package updates are currently reported." Opacity=".68" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="InstalledView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Installed" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Review software currently detected on this PC." Opacity=".72"/>
                    </StackPanel>
                    <StackPanel x:Name="InstalledActions" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,12">
                        <TextBox x:Name="InstalledSearchBox" MinWidth="220" MaxWidth="340" PlaceholderText="Filter installed apps" TextChanged="InstalledSearchBox_TextChanged" AutomationProperties.Name="Filter installed apps"/>
                        <Button Content="Refresh installed apps" Click="Installed_Click"/>
                        <Button x:Name="UninstallSelectedButton" Content="Uninstall selected" Click="UninstallSelected_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListView x:Name="InstalledResults" SelectionMode="Multiple" SelectionChanged="InstalledResults_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" Opacity=".62" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionDisplay}" Opacity=".66" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="InstalledEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="No packages detected" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Refresh after Windows Package Manager is available." Opacity=".68" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="DeviceView" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="This PC" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceDetails" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ArchitectureText"/>
                        <TextBlock x:Name="HealthDetails" Text="System health has not been checked yet." Opacity=".72" TextWrapping="Wrap"/>
                        <Button Content="Run system health check" Click="Health_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ActivityView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Activity" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Review recent installs, updates and removals stored locally on this PC." Opacity=".72"/>
                    </StackPanel>
                    <Button Grid.Row="1" Content="Clear activity" Click="ClearActivity_Click" HorizontalAlignment="Left" Margin="0,14,0,12"/>
                    <Grid Grid.Row="2">
                        <ListView x:Name="ActivityList">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PackageId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Action}" Opacity=".65"/>
                                                <TextBlock Text="{Binding Result}" Opacity=".65"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding At}" Opacity=".62" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="ActivityEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="No recent activity" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Installs, updates and removals will appear here." Opacity=".68" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Preferences are stored locally on this PC." Opacity=".72"/>
                        <CheckBox x:Name="ConfirmInstall" Content="Confirm before package changes" IsChecked="True"/>
                        <CheckBox x:Name="AutoRefresh" Content="Refresh package information automatically" IsChecked="True"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Search result limit"/>
                            <NumberBox x:Name="SearchLimitBox" Minimum="25" Maximum="500" SmallChange="25" Value="100"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Theme"/>
                            <ComboBox x:Name="ThemeBox" SelectedIndex="0">
                                <ComboBoxItem Content="System" Tag="system"/>
                                <ComboBoxItem Content="Light" Tag="light"/>
                                <ComboBoxItem Content="Dark" Tag="dark"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Reset settings" Click="ResetSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutView" Visibility="Collapsed">
                    <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Orvexa" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText"/>
                        <TextBlock Text="Software control center for Windows."/>
                        <TextBlock Text="Orvexa can use Windows Package Manager to discover, install, update and remove software." TextWrapping="Wrap"/>
                        <TextBlock Text="Third-party software remains subject to its publisher's license and terms." Opacity=".72" TextWrapping="Wrap"/>
                        <Button Content="View Orvexa license" Click="ViewLicense_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False"/>
                    <TextBlock x:Name="QueueStatus" Grid.Column="1" Text="Ready" Opacity=".72" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>