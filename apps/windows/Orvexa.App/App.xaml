<Application
    x:Class="Orvexa.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orvexa.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <local:PackageIconConverter x:Key="PackageIconConverter"/>
            <local:PackageDescriptionConverter x:Key="PackageDescriptionConverter"/>
            <local:PackageCategoryConverter x:Key="PackageCategoryConverter"/>

            <Color x:Key="OrvexaPrimaryBlue">#3B82FF</Color>
            <Color x:Key="OrvexaDeepBlue">#2563EB</Color>
            <Color x:Key="OrvexaNavy">#0B1B3D</Color>
            <Color x:Key="OrvexaSlate">#1E293B</Color>
            <Color x:Key="OrvexaMuted">#94A3B8</Color>
            <Color x:Key="OrvexaBorder">#334155</Color>
            <Color x:Key="OrvexaSurface">#F8FAFC</Color>
            <Color x:Key="OrvexaCard">#101C2F</Color>
            <Color x:Key="OrvexaCardElevated">#14233A</Color>
            <Color x:Key="OrvexaSuccess">#4ADE80</Color>
            <Color x:Key="OrvexaWarning">#FBBF24</Color>
            <Color x:Key="OrvexaDanger">#FB7185</Color>

            <SolidColorBrush x:Key="OrvexaPrimaryBrush" Color="{StaticResource OrvexaPrimaryBlue}"/>
            <SolidColorBrush x:Key="OrvexaDeepBlueBrush" Color="{StaticResource OrvexaDeepBlue}"/>
            <SolidColorBrush x:Key="OrvexaNavyBrush" Color="{StaticResource OrvexaNavy}"/>
            <SolidColorBrush x:Key="OrvexaSlateBrush" Color="{StaticResource OrvexaSlate}"/>
            <SolidColorBrush x:Key="OrvexaMutedBrush" Color="{StaticResource OrvexaMuted}"/>
            <SolidColorBrush x:Key="OrvexaBorderBrush" Color="{StaticResource OrvexaBorder}"/>
            <SolidColorBrush x:Key="OrvexaCardBrush" Color="{StaticResource OrvexaCard}"/>
            <SolidColorBrush x:Key="OrvexaCardElevatedBrush" Color="{StaticResource OrvexaCardElevated}"/>
            <SolidColorBrush x:Key="OrvexaSuccessBrush" Color="{StaticResource OrvexaSuccess}"/>
            <SolidColorBrush x:Key="OrvexaWarningBrush" Color="{StaticResource OrvexaWarning}"/>
            <SolidColorBrush x:Key="OrvexaDangerBrush" Color="{StaticResource OrvexaDanger}"/>

            <Style x:Key="OrvexaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OrvexaCardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource OrvexaBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="OrvexaTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
            </Style>

            <Style x:Key="OrvexaSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
            </Style>

            <Style x:Key="OrvexaSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OrvexaMutedBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="OrvexaPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OrvexaPrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>

            <Style x:Key="OrvexaSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#17263D"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="{StaticResource OrvexaBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>

            <Style x:Key="OrvexaChipStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#17263D"/>
                <Setter Property="Foreground" Value="#CBD5E1"/>
                <Setter Property="BorderBrush" Value="{StaticResource OrvexaBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>